DATABASE_URL=sqlite:///./aira.db
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Receives a copy of every submission and decision.
GOVERNANCE_EMAIL=sana.malik@jazz.example

# ---------- Outlook / Microsoft 365 mail ----------
# auto = Graph if configured, else SMTP, else log-only (no send)
MAIL_PROVIDER=auto
MAIL_ENABLED=true
MAIL_TIMEOUT_SECONDS=30
MAIL_REPLY_TO=

# Option A — Outlook SMTP (Microsoft 365)
# Enable SMTP AUTH for the mailbox if your tenant requires it.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=raio@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM=raio@yourdomain.com

# Option B — Microsoft Graph (recommended for production)
# Entra ID app: application permission Mail.Send + admin consent
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=raio@yourdomain.com

# Jazz AIOps Qwen meter gateway (OpenAI-compatible). Bearer token required.
LLM_BASE_URL=https://qwen38-27b-meter.apps.aiops.jazz.com.pk/v1
LLM_API_KEY=
LLM_MODEL=qwen38-27b
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=false
LLM_REQUIRE_API_KEY=true

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DUPLICATE_THRESHOLD=90

# Microsoft Entra ID SSO (OIDC). Leave blank to keep demo password login.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://your-host/api/v1/auth/oidc/callback
ENTRA_ALLOWED_ROLES=requester,reviewer,admin
