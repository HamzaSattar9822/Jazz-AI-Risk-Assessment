{
  "note": "Sample submission payloads for JazzWorld AIRA conversational intake. Types and allowedValues match backend/app/intake/catalog.py. Conditional fields appear only when their when-rule is true. Residual risk Tier 1-4 is calculated later, not chosen in intake.",
  "fieldCatalog": [
    {
      "name": "category",
      "dataType": "string",
      "allowedValues": ["AI For Us", "AI By Us", "AI Against Us"]
    },
    {
      "name": "name",
      "dataType": "string",
      "allowedValues": null
    },
    {
      "name": "owner",
      "dataType": "string",
      "allowedValues": null,
      "source": "profile"
    },
    {
      "name": "businessUnit",
      "dataType": "string",
      "allowedValues": [
        "Compliance", "CRA", "Cybersecurity", "Enterprise", "Finance", "GSM",
        "Internal Audit", "JazzCash", "JLV", "Legal", "MMBL", "P&O", "Strategy",
        "Technology", "Teknosys"
      ],
      "source": "profile"
    },
    {
      "name": "summary",
      "dataType": "string",
      "allowedValues": null,
      "source": "auto from description"
    },
    {
      "name": "segment",
      "dataType": "string",
      "allowedValues": [
        "Consumer-Facing AI",
        "Corporate AI",
        "Enterprise AI",
        "Internal Operations",
        "Other"
      ]
    },
    {
      "name": "valueDriver",
      "dataType": "string",
      "allowedValues": [
        "Productivity",
        "Revenue Uplift",
        "Cost Reduction",
        "Customer Experience",
        "Efficiency",
        "Governance",
        "Other"
      ]
    },
    {
      "name": "annualValue",
      "dataType": "string",
      "allowedValues": null,
      "formatHint": "USD amount or ROI text, e.g. \"20000\" or \"10% ROI\""
    },
    {
      "name": "investmentCost",
      "dataType": "string",
      "allowedValues": null,
      "formatHint": "USD amount text, e.g. \"50000\""
    },
    {
      "name": "spendingToDate",
      "dataType": "string",
      "allowedValues": null,
      "formatHint": "USD amount text, e.g. \"0\" or \"12000\""
    },
    {
      "name": "hoursSaved",
      "dataType": "string",
      "allowedValues": null,
      "formatHint": "e.g. \"500 hours / year\""
    },
    {
      "name": "sensitive",
      "dataType": "string",
      "allowedValues": ["Yes", "No"]
    },
    {
      "name": "decision",
      "dataType": "string",
      "allowedValues": ["Yes", "No"]
    },
    {
      "name": "action",
      "dataType": "string",
      "allowedValues": ["Yes", "No"]
    },
    {
      "name": "forTool",
      "dataType": "string",
      "allowedValues": null,
      "requiredWhen": "category == AI For Us"
    },
    {
      "name": "forAccess",
      "dataType": "string",
      "allowedValues": [
        "JazzWorld enterprise / corporate account",
        "Supplier-managed enterprise service",
        "Public / free web service",
        "Individual / personal account",
        "API / system integration"
      ],
      "requiredWhen": "category == AI For Us AND sensitive == Yes"
    },
    {
      "name": "threatTypes",
      "dataType": "string[]",
      "allowedValues": [
        "Phishing / social engineering",
        "Deepfake / impersonation",
        "Fraud / scam",
        "Malware / cyber attack",
        "Prompt / model abuse",
        "Other"
      ],
      "requiredWhen": "category == AI Against Us"
    },
    {
      "name": "dataExternal",
      "dataType": "string",
      "allowedValues": ["Yes", "No"],
      "requiredWhen": "sensitive == Yes"
    },
    {
      "name": "humanReview",
      "dataType": "string",
      "allowedValues": [
        "Always",
        "Sometimes / based on conditions",
        "No - AI output can determine the outcome"
      ],
      "requiredWhen": "decision == Yes"
    },
    {
      "name": "autonomy",
      "dataType": "string",
      "allowedValues": [
        "Advisory only - it cannot take action",
        "Action requires human approval each time",
        "Can take limited actions within defined rules",
        "Can take actions automatically across a workflow"
      ],
      "requiredWhen": "action == Yes"
    }
  ],
